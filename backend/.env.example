
# --- Database ---------------------------------------------------------
# Local dev (SQLite): file:./dev.db
# Production (Postgres): postgresql://user:password@host:5432/bizzcore
DATABASE_URL="file:./dev.db"

# --- Auth ---------------------------------------------------------------
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="bizzcore_session"

# 32-byte (64 hex char) key used to AES-256-GCM encrypt IntegrationCredential
# payloads at rest. Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY="replace-with-64-hex-characters"

# 32-byte (64 hex char) key used to HMAC-SHA256 hash Customer PII (phone) for
# exact-match lookup without decrypting — deliberately separate from
# CREDENTIAL_ENCRYPTION_KEY so a lookup-hash leak can't help decrypt anything.
# Generate with: openssl rand -hex 32
PII_LOOKUP_HASH_KEY="replace-with-64-hex-characters"

# --- App ------------------------------------------------------------------
# Set to "production" in real deployments — this is what makes `npm run seed`
# refuse to plant the demo Super Admin / demo tenants (see prisma/seed.ts's
# assertNotProduction). Provision the real Super Admin instead with:
#   npm run super-admin:create -- --email you@yourcompany.com --name "Your Name"
NODE_ENV="development"
# Only set this to "true" for a deliberate non-production demo/sales
# environment where you actually want the seeded demo data. Never set this
# in real production.
ALLOW_DEMO_SEED_IN_PRODUCTION="false"

PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"
APP_LOGIN_URL="http://localhost:5173/login"

# Publicly reachable base URL for this backend, used to build absolute
# media URLs when publishing to Instagram/Facebook (Meta's servers fetch
# the image from this URL — a localhost value only works with mock mode).
# Defaults to http://localhost:$PORT if unset.
APP_PUBLIC_URL=""

# --- AI Marketing Assistant (OpenAI) ---------------------------------------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Content Research Lab (Apify) -------------------------------------------
# Platform-level — one BizzCore-owned Apify account funds every tenant's
# research runs (tenants don't have their own Apify accounts), gated
# per-tenant by the CONTENT_RESEARCH usage quota. From Apify dashboard >
# Settings > API & Integrations > Personal API tokens.
APIFY_API_TOKEN=""

# --- Email ------------------------------------------------------------------
# EMAIL_PROVIDER selects which adapter is active: resend | sendgrid |
# postmark | smtp (default). resend/sendgrid/postmark call that provider's
# HTTP API directly (with automatic retries on transient failures — network
# errors, 5xx, 429). Only that provider's own credential env var needs to be
# set; switching providers, or going from mock to live, is an env var
# change, no code change.
#
# EMAIL_FROM must be a sender address whose domain you've verified with your
# provider (SPF/DKIM records added in their dashboard — Resend/SendGrid/
# Postmark/SES all require this before they'll deliver to real inboxes, not
# just their own sandbox/test addresses). Do this once per provider, in
# their dashboard, before going live.
EMAIL_PROVIDER="smtp"
EMAIL_FROM="BizzCore <no-reply@yourdomain.com>"

# Where a recipient's reply actually lands if they hit "Reply" on an
# automated system email (credentials, password resets, alerts). Defaults
# to support@bizzcore.in in code if unset, so this is optional here.
EMAIL_REPLY_TO="BizzCore <support@yourdomain.com>"

# Resend — https://resend.com/api-keys (verify your domain at resend.com/domains)
RESEND_API_KEY=""

# SendGrid — https://app.sendgrid.com/settings/api_keys (verify sender identity/domain under Settings > Sender Authentication)
SENDGRID_API_KEY=""

# Postmark — https://account.postmarkapp.com/servers (verify your Sender Signature / domain under that server's Sender Signatures tab)
POSTMARK_SERVER_TOKEN=""

# SMTP (nodemailer) — the default provider, and also the recommended path
# for Amazon SES (SES's own docs favor SMTP for simple integrations over
# hand-rolling AWS SigV4 request signing). Any SMTP-speaking provider works
# here with zero code changes, including the three above if you'd rather use
# their SMTP relay instead of EMAIL_PROVIDER=resend/sendgrid/postmark.
#
#   SendGrid:  SMTP_HOST=smtp.sendgrid.net       SMTP_PORT=587  SMTP_USER=apikey                SMTP_PASSWORD=<SendGrid API key>
#   Resend:    SMTP_HOST=smtp.resend.com         SMTP_PORT=465  SMTP_USER=resend                SMTP_PASSWORD=<Resend API key>
#   SES:       SMTP_HOST=email-smtp.<region>.amazonaws.com  SMTP_PORT=587  SMTP_USER=<SES SMTP username>  SMTP_PASSWORD=<SES SMTP password>
#   Postmark:  SMTP_HOST=smtp.postmarkapp.com    SMTP_PORT=587  SMTP_USER=<Server API token>     SMTP_PASSWORD=<same token>
#
# (SES's SMTP username/password are NOT your AWS access key pair — generate
# dedicated SMTP credentials in the SES console, and verify your sending
# domain/identity under SES > Verified identities first.)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="BizzCore <no-reply@bizzcore.example>"

# --- Password reset -----------------------------------------------------
PASSWORD_RESET_TOKEN_TTL_MINUTES="60"

# --- Billing (Razorpay) -------------------------------------------------
# BILLING_PROVIDER selects the active payment gateway adapter (see
# integrations/razorpay.ts) — currently only "razorpay" is implemented, but
# the switch-based dispatch exists so a second provider is a new adapter
# file, not a rewrite of routes/billing.ts.
BILLING_PROVIDER="razorpay"

# Razorpay Dashboard -> Settings -> API Keys. Use TEST mode keys
# (rzp_test_...) until you're ready to go live. KEY_ID is also sent to the
# frontend (Razorpay Checkout requires it client-side) — KEY_SECRET never
# leaves the backend.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Razorpay Dashboard -> Settings -> Webhooks. Register
# https://<your-domain>/api/webhooks/razorpay there (must be HTTPS), select
# at least "payment.captured" and "payment.failed", then paste the secret
# Razorpay generates into this value. Required for
# routes/webhooks/razorpay.ts to verify that a webhook call genuinely came
# from Razorpay before trusting it.
RAZORPAY_WEBHOOK_SECRET=""

# Cloudflare R2 (object storage — see lib/objectStorage.ts) — every tenant
# upload (product/content images, logos, social media) lives here, not on
# local disk, since a PaaS filesystem doesn't survive a restart/redeploy.
# Required at boot (see lib/env.ts's validateEnv) — there is no local-disk
# fallback anymore.
#   R2_ACCOUNT_ID/ACCESS_KEY_ID/SECRET_ACCESS_KEY: Cloudflare dashboard ->
#     R2 -> Manage R2 API Tokens -> Create API Token (Object Read & Write).
#   R2_BUCKET_NAME: the bucket you created under R2 -> Overview.
#   R2_PUBLIC_URL: that bucket's public base URL (Settings -> Public
#     Access) — either the instant r2.dev subdomain, or a custom domain you
#     connected. No trailing slash.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# --- Meta (Instagram/Facebook Graph API) — platform-level defaults, ------
# per-tenant overrides live encrypted in IntegrationCredential
META_GRAPH_API_VERSION="v20.0"

# --- WhatsApp Business Platform (Cloud API) ---------------------------
WHATSAPP_GRAPH_API_VERSION="v20.0"

# Platform-level credentials — BizzCore's OWN WhatsApp Business number,
# distinct from any tenant's own WHATSAPP IntegrationCredential (configured
# per-tenant in Settings, for messaging that tenant's customers). Used only
# for transactional messages BizzCore itself sends about a business's
# account — currently: credential delivery on Super Admin's Add Business /
# Resend credentials (see integrations/whatsapp.ts's
# sendPlatformWhatsAppMessage). Get phoneNumberId + a permanent access token
# from Meta for Developers (developers.facebook.com) -> your app -> WhatsApp
# -> API Setup. A brand-new recipient (a business owner who's never
# messaged this number before) is outside WhatsApp's 24-hour customer-
# service window, so this first message will likely need to be sent as an
# APPROVED MESSAGE TEMPLATE, not freeform text — set one up under WhatsApp
# Manager -> Message Templates before relying on this in production.
WHATSAPP_PLATFORM_PHONE_NUMBER_ID=""
WHATSAPP_PLATFORM_ACCESS_TOKEN=""

# Once you've created + gotten Meta's approval for a platform-level
# template (any tenant Admin can create one for their OWN WABA from
# Settings -> WhatsApp Templates; a template for BizzCore's OWN platform
# number has to be created the same way, using a tenant connection whose
# WABA IS the platform WABA, since there's no separate Super Admin
# template UI here), set BOTH of these to switch sendPlatformWhatsAppMessage
# (credential delivery) from freeform text to this template. Leave either
# blank and it keeps sending freeform text exactly as before.
#
# The approved template's body must have exactly FOUR placeholders, in
# this order — {{1}} business name, {{2}} login email, {{3}} temporary
# password, {{4}} login URL — e.g.:
#   "Hi, your BizzCore account for {{1}} is ready. Email: {{2}}
#    Temporary password: {{3}} Login: {{4}}"
# (see integrations/whatsapp.ts's PlatformCredentialMessage/
# sendPlatformWhatsAppMessage for exactly how these four map in).
WHATSAPP_PLATFORM_TEMPLATE_NAME=""
# BCP-47 language/locale code exactly as approved, e.g. "en_US" or "en".
WHATSAPP_PLATFORM_TEMPLATE_LANGUAGE=""

# Meta App Dashboard -> WhatsApp -> Configuration requires a "Callback URL"
# + "Verify Token" before it'll let you finish connecting a phone number —
# see routes/webhooks/whatsapp.ts. Callback URL must be a public HTTPS
# endpoint: https://<your-domain>/api/webhooks/whatsapp (a bare localhost
# URL will not work; use a tunnel like `npx localtunnel --port $PORT` for
# local testing, or your real deployed URL in production). Verify Token is
# a value YOU choose here, then paste the SAME value into Meta's dashboard —
# it's what routes/webhooks/whatsapp.ts's GET handler checks against to
# confirm the handshake request genuinely came from Meta's setup flow.
# Generate with: openssl rand -hex 24
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Meta App Dashboard -> Settings -> Basic -> App Secret ("Show" button).
# Required for every POST event delivery once you're handling real traffic
# — routes/webhooks/whatsapp.ts HMAC-SHA256's the raw request body with
# this and compares it against the X-Hub-Signature-256 header Meta sends,
# so it can trust that an incoming message/status event genuinely came from
# Meta and not from anyone who guesses the Callback URL. Without this set,
# the webhook refuses every POST with a 500 rather than silently accepting
# unsigned events (same fail-closed choice as RAZORPAY_WEBHOOK_SECRET
# above) — the GET verification handshake above doesn't need it.
WHATSAPP_APP_SECRET=""
